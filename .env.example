# Public site URL, used for canonical URLs, sitemap, OG images, JSON-LD.
# On Vercel this can be left as-is; set it to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics measurement ID (GoogleAnalytics is only mounted after cookie consent).
# Leave blank if you don't use Google Analytics — the site works fine without it.
NEXT_PUBLIC_GA_ID=

# URL of an external form (e.g. a Google Form) used by the /contact page's "Get in touch" button.
NEXT_PUBLIC_CONTACT_FORM_URL=https://forms.gle/example
